# HMAC secret used to sign immutable configuration revisions and cart intents.
# Set a long random value in Vercel project settings. A dev fallback is used when unset.
PENFORGE_SIGNING_SECRET=

# "mock" (default) keeps a browser-local theme cart. "shopify" posts to the storefront Ajax Cart API
# and expects the app to be mounted inside a Shopify theme (theme app extension).
NEXT_PUBLIC_COMMERCE_ADAPTER=mock
